{
	"name": "omniclip",
	"version": "2.0.0-4",
	"description": "",
	"main": "x/index.js",
	"files": [
		"x",
		"s"
	],
	"type": "module",
	"scripts": {
		"build": "run-s _clean _coi _ln _tsc _scute",
		"watch": "octo 'scute -wv' 'tsc -w' 'node --watch x/tests.test.js' 'http-server x'",
		"test": "node x/tests.test.js",
		"count": "find s -path '*/mp4boxjs' -prune -o -path '*/icons' -prune -o -name '*.mp4' -prune -o -name 'pixi.mjs.d.ts' -prune -o -name '*.ts' -exec wc -l {} +",
		"_clean": "rm -rf x && mkdir x",
		"_tsc": "tsc",
		"_scute": "scute -v",
		"_coi": "cp node_modules/coi-serviceworker/coi-serviceworker.js x/",
		"_ln": "run-s _ln-s _ln-assets _ln-nm",
		"_ln-s": "ln -s \"$(realpath s)\" x/s",
		"_ln-assets": "ln -s \"$(realpath assets)\" x/assets",
		"_ln-nm": "ln -s \"$(realpath node_modules)\" x/node_modules"
	},
	"author": "zenkyuv",
	"license": "MIT",
