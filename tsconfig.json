{
	"compilerOptions": {
		"strict": true,
		"rootDir": "s",
		"outDir": "x",
		"target": "es2023",
		"lib": ["es2023", "dom", "dom.asynciterable", "webworker"],
		"module": "node16",
		"moduleResolution": "node16",
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"declaration": true,
		"skipLibCheck": true,
		"types": ["@types/wicg-file-system-access", "@types/dom-webcodecs"]
	},
	"include": [
		"s/**/*.ts",
		"s/**/*.js"
	],
	"exclude": [
		"s/**/_*",
		"assets/**/*"
	]
}
